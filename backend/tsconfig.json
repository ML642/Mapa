{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    // "outDir": "./dist",
    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es6",
    "types": ["node"],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node
    // Other Outputs
    "allowJs": true,
    "checkJs": false,
    "outDir": "./dist",
    // "baseUrl": ".",
    // "paths": {
    //   "@/*": [
    //     "src/*"
    //   ]
    // }
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,
    // Recommended Options
    "strict": false, // TODO: false for now change to true
    "strictNullChecks": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false, // TODO: false for now change to true
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0" // TODO: при переходе на TS 7.0 нужно убрать изменить config
  },
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "vitest.config.ts"
  ]
  
}
