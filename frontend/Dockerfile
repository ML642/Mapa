# syntax=docker/dockerfile:1

###################
# Base stage
###################
FROM node:20-alpine AS base

WORKDIR /app

# Зависимости (максимальный кэш)
COPY package.json package-lock.json ./
RUN npm ci

# Исходники
COPY . .

# Env приходит извне и используется как в prod build,
# так и при запуске dev server внутри контейнера.
ARG VITE_API_URL
ARG VITE_MAPBOX_ACCESS_TOKEN
ARG VITE_MAPBOX_STYLE
ARG VITE_MAPBOX_DEFAULT_CENTER_LAT
ARG VITE_MAPBOX_DEFAULT_CENTER_LNG
ARG VITE_MAPBOX_DEFAULT_ZOOM
ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_GOOGLE_MAPS_EMBED_API_KEY
ARG VITE_YANDEX_MAPS_API_KEY
ARG VITE_TELEGRAM_SHARE_URL
ARG VITE_WHATSAPP_SHARE_URL
ARG VITE_VK_SHARE_URL
ARG VITE_INSTAGRAM_URL
ARG VITE_SITE_TITLE
ARG VITE_SITE_DESCRIPTION
ARG VITE_OG_TITLE
ARG VITE_OG_DESCRIPTION
ARG VITE_SITE_URL

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_MAPBOX_ACCESS_TOKEN=$VITE_MAPBOX_ACCESS_TOKEN
ENV VITE_MAPBOX_STYLE=$VITE_MAPBOX_STYLE
ENV VITE_MAPBOX_DEFAULT_CENTER_LAT=$VITE_MAPBOX_DEFAULT_CENTER_LAT
ENV VITE_MAPBOX_DEFAULT_CENTER_LNG=$VITE_MAPBOX_DEFAULT_CENTER_LNG
ENV VITE_MAPBOX_DEFAULT_ZOOM=$VITE_MAPBOX_DEFAULT_ZOOM
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_GOOGLE_MAPS_EMBED_API_KEY=$VITE_GOOGLE_MAPS_EMBED_API_KEY
ENV VITE_YANDEX_MAPS_API_KEY=$VITE_YANDEX_MAPS_API_KEY
ENV VITE_TELEGRAM_SHARE_URL=$VITE_TELEGRAM_SHARE_URL
ENV VITE_WHATSAPP_SHARE_URL=$VITE_WHATSAPP_SHARE_URL
ENV VITE_VK_SHARE_URL=$VITE_VK_SHARE_URL
ENV VITE_INSTAGRAM_URL=$VITE_INSTAGRAM_URL
ENV VITE_SITE_TITLE=$VITE_SITE_TITLE
ENV VITE_SITE_DESCRIPTION=$VITE_SITE_DESCRIPTION
ENV VITE_OG_TITLE=$VITE_OG_TITLE
ENV VITE_OG_DESCRIPTION=$VITE_OG_DESCRIPTION
ENV VITE_SITE_URL=$VITE_SITE_URL

###################
# Build stage
###################
FROM base AS build

RUN npm run build

###################
# Production stage
###################
FROM nginx:alpine AS production

# Чистим дефолт
RUN rm -rf /usr/share/nginx/html/*

# Копируем билд
COPY --from=build /app/dist /usr/share/nginx/html

# (опционально) свой nginx.conf
COPY nginx.conf /etc/nginx/nginx.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

###################
# Development stage
###################
FROM base AS development

ENV HOST=0.0.0.0
ENV PORT=5173

EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
